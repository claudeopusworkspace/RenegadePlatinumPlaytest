# ROM files (copyrighted)
*.nds

# Emulator state (binary, large, session-specific)
savestates/
snapshots/

# RAM dumps (temporary analysis artifacts)
*.bin

# Generated output files (regenerated on demand)
map_view.txt
nav_view.txt

# DeSmuME MCP subproject (legacy, separate repo)
DesmumeMCP/

# Reference decompilation (external repo, ~26k files)
ref/

# ROM extracted data (large, can be re-extracted)
romdata/

# Emulator checkpoints (ring buffer, huge)
checkpoints/

# Session recordings (MelonMCP HLS + session capture, mp4/json)
recordings/

# MelonMCP streaming journal + renderer artifacts (ephemeral, PID-suffixed)
.melonds_journal_*.jsonl
.renderer_*.log
.renderer_frame_*

# Auto-grind session logs
logs/

# MCP server logs (rotated)
melonds_mcp.log*
melonds_test_mcp.log*
desmume_mcp.log*

# IPC bridge sockets
.melonds_bridge.sock
.melonds_test_bridge.sock
.desmume_bridge.sock

# Battery save (exported from emulator, large binary)
*.sav

# Python
__pycache__/
*.pyc
.venv/
